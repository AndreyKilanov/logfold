from collections.abc import Callable
from typing import Any

__version__: str

class CoreConfigError(Exception): ...
class CoreFormatError(Exception): ...
class CoreSourceError(Exception): ...
class CoreStateError(Exception): ...

def api_version() -> int: ...
def algo_version() -> int: ...
def default_masks() -> list[dict[str, Any]]: ...
def match_templates(
    kind: str,
    before: list[str],
    after: list[str],
    threshold: float | None = None,
    rules: list[tuple[str, str]] | None = None,
) -> list[tuple[int, int]]: ...
def render_report(report: str, data: dict[str, Any], options: dict[str, Any]) -> str: ...
def compare_runs(
    before_texts: list[str],
    before_counts: list[int],
    before_total: int,
    after_texts: list[str],
    after_counts: list[int],
    after_total: int,
    ratio: float,
    min_count: int,
    min_new_count: int,
    matcher: str,
    threshold: float | None = None,
    rules: list[tuple[str, str]] | None = None,
) -> tuple[list[int], list[int], list[tuple[int, int, float, float, float | None]], int]: ...
def mine(request: dict[str, Any], progress: Callable[[int], None] | None = None) -> dict[str, Any]: ...
def match_state(request: dict[str, Any], progress: Callable[[int], None] | None = None) -> dict[str, Any]: ...
def inspect_sample(sample: bytes, format: dict[str, Any], keep: int) -> dict[str, Any]: ...

class NativeExtractor:
    def __init__(self, masks: list[dict[str, Any]], delimiters: str) -> None: ...
    def extract(self, template: str, messages: list[str]) -> list[list[tuple[int, str, str]] | None]: ...

class NativeMiner:
    def __init__(self, request: dict[str, Any]) -> None: ...
    def add_many(self, records: list[str]) -> int: ...
    def add_lines(self, lines: list[str]) -> int: ...
    def flush(self) -> int: ...
    def match_many(self, records: list[str], exact: bool = False) -> tuple[list[tuple[str, str]], list[int | None]]: ...
    def new_templates(self) -> list[str]: ...
    def result(self) -> dict[str, Any]: ...
    def save_state(self, path: str, state_format: str | None = None) -> None: ...
