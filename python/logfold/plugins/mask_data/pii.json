{
  "$schema": "https://github.com/AndreyKilanov/logfold/blob/main/docs/schema/mask-set.schema.json",
  "name": "pii",
  "version": 1,
  "description": "E-mail addresses and international phone numbers. Cheap: every rule has a literal.",
  "rules": [
    {
      "name": "email",
      "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}\\b",
      "token": "<EMAIL>"
    },
    {
      "name": "phone",
      "pattern": "\\+(?:[1-9]\\d{0,2}(?:[ .-]|[ .-]?\\()(?:[ .()-]{0,2}\\d){6,13}|[1-9]\\d{9,14})\\b",
      "token": "<PHONE>"
    }
  ]
}
