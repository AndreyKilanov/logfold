{
  "$schema": "https://github.com/AndreyKilanov/logfold/blob/main/docs/schema/mask-set.schema.json",
  "name": "credentials",
  "version": 1,
  "description": "Authorization headers, Bearer tokens, passwords in URLs and password=, token=, api_key= pairs. Costs more: words in any case.",
  "rules": [
    {
      "name": "auth_header",
      "pattern": "\\b(?i:proxy-)?(?i:authorization)[\\\"']?[ \\t]*[:=][ \\t]*[\\\"']?(?:[A-Za-z]+[ \\t]+)?[^\\s\\\"',;]{4,}",
      "token": "<SECRET>"
    },
    {
      "name": "bearer",
      "pattern": "\\b(?i:bearer)[ \\t]+[A-Za-z0-9._~+/-]{16,}=*",
      "token": "<SECRET>"
    },
    {
      "name": "url_password",
      "pattern": "\\b[A-Za-z][A-Za-z0-9+.-]*://[^\\s/@:]+:[^\\s/@]+@",
      "token": "<SECRET>"
    },
    {
      "name": "password_pair",
      "pattern": "(?i:pass(?:word|wd|phrase)|pwd)[\\\"']?[ \\t]*[:=][ \\t]*[\\\"']?[^\\s\\\"'&,;)}\\]{\\[(<][^\\s\\\"'&,;)}\\]]{2,}",
      "token": "<SECRET>"
    },
    {
      "name": "credential_pair",
      "pattern": "(?i:secret[_-]?key|secret|token|api[_-]?key|access[_-]?key|private[_-]?key)[\\\"']?[ \\t]*[:=][ \\t]*[\\\"']?[^\\s\\\"'&,;)}\\]{\\[(<][^\\s\\\"'&,;)}\\]]{7,}",
      "token": "<SECRET>"
    }
  ]
}
