{
  "$schema": "https://github.com/AndreyKilanov/logfold/blob/main/docs/schema/mask-set.schema.json",
  "name": "secrets",
  "version": 1,
  "description": "Private keys, JWTs and API keys with a known prefix. Cheap: every rule starts with a literal.",
  "rules": [
    {
      "name": "private_key_block",
      "pattern": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----[^-]{16,}-----END (?:[A-Z0-9]+ )*PRIVATE KEY-----",
      "token": "<KEY>"
    },
    {
      "name": "private_key_header",
      "pattern": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----",
      "token": "<KEY>"
    },
    {
      "name": "jwt",
      "pattern": "\\beyJ[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]*",
      "token": "<JWT>"
    },
    {
      "name": "aws_key",
      "pattern": "\\b(?:AKIA|ASIA|AGPA|AIDA|AROA|ANPA|ANVA|AIPA)[A-Z0-9]{16}\\b",
      "token": "<KEY>"
    },
    {
      "name": "github_token",
      "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,255}\\b",
      "token": "<KEY>"
    },
    {
      "name": "github_pat",
      "pattern": "\\bgithub_pat_[A-Za-z0-9_]{22,255}",
      "token": "<KEY>"
    },
    {
      "name": "gitlab_token",
      "pattern": "\\bglpat-[A-Za-z0-9_-]{20,}",
      "token": "<KEY>"
    },
    {
      "name": "slack_token",
      "pattern": "\\bxox[abprs]-[A-Za-z0-9-]{10,}",
      "token": "<KEY>"
    },
    {
      "name": "stripe_key",
      "pattern": "\\b[rs]k_(?:live|test)_[A-Za-z0-9]{16,}\\b",
      "token": "<KEY>"
    },
    {
      "name": "google_key",
      "pattern": "\\bAIza[A-Za-z0-9_-]{35}",
      "token": "<KEY>"
    },
    {
      "name": "npm_token",
      "pattern": "\\bnpm_[A-Za-z0-9]{36}\\b",
      "token": "<KEY>"
    },
    {
      "name": "sendgrid_key",
      "pattern": "\\bSG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}",
      "token": "<KEY>"
    },
    {
      "name": "openai_key",
      "pattern": "\\bsk-[A-Za-z0-9_-]{20,}",
      "token": "<KEY>"
    }
  ]
}
