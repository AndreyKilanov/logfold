{
  "$schema": "https://github.com/AndreyKilanov/logfold/blob/main/docs/schema/mask-set.schema.json",
  "name": "secrets",
  "version": 1,
  "description": "Tokens, API keys, passwords and private keys. Explainable rules only, no entropy guesses.",
  "rules": [
    {
      "name": "private_key_block",
      "pattern": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----[^-]{16,}-----END (?:[A-Z0-9]+ )*PRIVATE KEY-----",
      "token": "<KEY>"
    },
    {
      "name": "private_key_header",
      "pattern": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----",
      "token": "<KEY>"
    },
    {
      "name": "jwt",
      "pattern": "\\beyJ[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]*",
      "token": "<JWT>"
    },
    {
      "name": "auth_header",
      "pattern": "\\b(?i:proxy-)?(?i:authorization)[\\\"']?[ \\t]*[:=][ \\t]*[\\\"']?(?:[A-Za-z]+[ \\t]+)?[^\\s\\\"',;]{4,}",
      "token": "<SECRET>"
    },
    {
      "name": "bearer",
      "pattern": "\\b(?i:bearer)[ \\t]+[A-Za-z0-9._~+/-]{16,}=*",
      "token": "<SECRET>"
    },
    {
      "name": "aws_key",
      "pattern": "\\b(?:AKIA|ASIA|AGPA|AIDA|AROA|ANPA|ANVA|AIPA)[A-Z0-9]{16}\\b",
      "token": "<KEY>"
    },
    {
      "name": "github_token",
      "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,255}\\b",
      "token": "<KEY>"
    },
    {
      "name": "github_pat",
      "pattern": "\\bgithub_pat_[A-Za-z0-9_]{22,255}",
      "token": "<KEY>"
    },
    {
      "name": "gitlab_token",
      "pattern": "\\bglpat-[A-Za-z0-9_-]{20,}",
      "token": "<KEY>"
    },
    {
      "name": "slack_token",
      "pattern": "\\bxox[abprs]-[A-Za-z0-9-]{10,}",
      "token": "<KEY>"
    },
    {
      "name": "stripe_key",
      "pattern": "\\b[rs]k_(?:live|test)_[A-Za-z0-9]{16,}\\b",
      "token": "<KEY>"
    },
    {
      "name": "google_key",
      "pattern": "\\bAIza[A-Za-z0-9_-]{35}",
      "token": "<KEY>"
    },
    {
      "name": "npm_token",
      "pattern": "\\bnpm_[A-Za-z0-9]{36}\\b",
      "token": "<KEY>"
    },
    {
      "name": "sendgrid_key",
      "pattern": "\\bSG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}",
      "token": "<KEY>"
    },
    {
      "name": "openai_key",
      "pattern": "\\bsk-[A-Za-z0-9_-]{20,}",
      "token": "<KEY>"
    },
    {
      "name": "url_password",
      "pattern": "\\b[A-Za-z][A-Za-z0-9+.-]*://[^\\s/@:]+:[^\\s/@]+@",
      "token": "<SECRET>"
    },
    {
      "name": "password_pair",
      "pattern": "(?i:pass(?:word|wd|phrase)|pwd)[\\\"']?[ \\t]*[:=][ \\t]*[\\\"']?[^\\s\\\"'&,;)}\\]{\\[(<][^\\s\\\"'&,;)}\\]]{2,}",
      "token": "<SECRET>"
    },
    {
      "name": "credential_pair",
      "pattern": "(?i:secret[_-]?key|secret|token|api[_-]?key|access[_-]?key|private[_-]?key)[\\\"']?[ \\t]*[:=][ \\t]*[\\\"']?[^\\s\\\"'&,;)}\\]{\\[(<][^\\s\\\"'&,;)}\\]]{7,}",
      "token": "<SECRET>"
    }
  ]
}
